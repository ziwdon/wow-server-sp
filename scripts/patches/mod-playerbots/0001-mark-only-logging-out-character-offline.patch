+    // wow-server-sp local patch: mark only the logging-out character offline.
+    // The core marks every character of the account offline at logout, but a
+    // playerbots account can have several characters in the world at once
+    // (random bots; alt bots on a real player's account), so one logout would
+    // flag its still-online siblings offline until their next save.
+    bool OnPlayerCanMarkAccountOffline(ObjectGuid guid, uint32 /*accountId*/) override
+    {
+        CharacterDatabase.Execute("UPDATE characters SET online = 0 WHERE guid = {}", guid.GetCounter());
+        return false;
+    }
